# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo local config
.cargo/config.toml
.cargo/config

# Editor + OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test scratch
/tmp/
*.log

# Extracted specs cache (phase 3+)
/specs-data-cache/

# Full extras tree (1000+ specs, 100+ MB) is regenerated by running
# `tools/extractor/npm run extract` against @withfig/autocomplete.
# Committing would bloat the repo; users fetch or regenerate locally.
/specs-data/extras/

# Secrets
.env
.env.*
!.env.example
