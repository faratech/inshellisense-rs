                      "name": "callback_url"
                    }
                  ]
                },
                {
                  "names": [
                    "--client_id"
                  ],
                  "description": "Client ID/Consumer Key from the Connected App",
                  "is_required": true,
                  "args": [
                    {
                      "name": "client_id"
                    }
                  ]
                },
                {
                  "names": [
                    "--client_secret"
                  ],
                  "description": "Client Secret/Consumer Secret from the Connected App",
