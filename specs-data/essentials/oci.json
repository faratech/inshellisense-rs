            },
            {
              "name": "eu-amsterdam-1"
            },
            {
              "name": "eu-zurich-1"
            },
            {
              "name": "eu-madrid-1"
            },
            {
              "name": "uk-london-1"
            },
            {
              "name": "uk-cardiff-1"
            },
            {
              "name": "ap-tokyo-1"
            },
            {
              "name": "ap-osaka-1"
