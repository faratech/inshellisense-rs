            },
            {
              "name": "ap-sydney-1"
            },
            {
              "name": "ap-melbourne-1"
            },
            {
              "name": "ap-hyderabad-1"
            },
            {
              "name": "ap-mumbai-1"
            },
            {
              "name": "me-dubai-1"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--output"
      ],
      "description": "The output format",
      "args": [
        {
          "suggestions": [
            {
              "name": "json"
            },
            {
              "name": "table"
            },
            {
              "name": "text"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--debug"
      ],
      "description": "Turn on debug logging"
    },
    {
      "names": [
        "--auth"
      ],
      "description": "The type of auth to use",
      "args": [
        {
          "suggestions": [
            {
              "name": "api_key"
            },
            {
              "name": "instance_principal"
            },
            {
              "name": "resource_principal"
            },
            {
              "name": "security_token"
            },
            {
              "name": "raw_token"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--key-file"
      ],
      "description": "The path to the private key file",
      "args": [
        {
          "templates": [
            "filepaths"
          ]
        }
      ]
    },
    {
      "names": [
        "--wait-for-state"
      ],
      "description": "Wait until resource reaches a given state",
      "args": [
        {
          "suggestions": [
            {
              "name": "ACCEPTED"
            },
            {
              "name": "AVAILABLE"
            },
            {
              "name": "RUNNING"
            },
            {
              "name": "PROVISIONING"
            },
            {
              "name": "STOPPED"
            },
            {
              "name": "TERMINATED"
            },
            {
              "name": "FAILED"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--wait-interval-seconds"
      ],
      "description": "Check interval seconds for --wait-for-state",
      "args": [
        {
          "name": "seconds",
          "default": "30"
        }
      ]
    },
    {
      "names": [
        "--max-wait-seconds"
      ],
      "description": "Maximum time to wait",
      "args": [
        {
          "name": "seconds",
          "default": "1200"
        }
      ]
    },
    {
      "names": [
        "--raw-output"
      ],
      "description": "Output raw response from OCI API"
    },
    {
      "names": [
        "--output-format"
      ],
      "description": "The output format for commands",
      "args": [
        {
          "suggestions": [
            {
              "name": "json"
            },
            {
              "name": "table"
            },
            {
              "name": "text"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--query"
      ],
      "description": "JMESPath query to filter the output"
    }
  ]
}
