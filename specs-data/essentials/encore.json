    }
  ],
  "options": [
    {
      "names": [
        "--verbose",
        "-v"
      ],
      "description": "Verbose output",
      "is_persistent": true,
      "args": [
        {
          "name": "verbose",
          "default": "0"
        }
      ]
    },
    {
      "names": [
        "--help",
        "-h"
      ],
      "description": "Display help",
      "is_persistent": true
    }
  ]
}
