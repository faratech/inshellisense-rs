{
  "names": [
    "pnpx"
  ],
  "description": "Execute binaries from npm packages",
  "subcommands": [
    {
      "names": [
        "create-react-native-app"
      ],
      "icon": "https://reactnative.dev/img/pwa/manifest-icon-512.png",
      "load_spec": {
        "kind": "spec_path",
        "name": "create-react-native-app"
      }
    },
    {
      "names": [
        "react-native"
      ],
      "icon": "https://reactnative.dev/img/pwa/manifest-icon-512.png",
      "load_spec": {
        "kind": "spec_path",
        "name": "react-native"
      }
    },
    {
      "names": [
        "tailwindcss"
      ],
      "icon": "https://tailwindcss.com/favicon-32x32.png",
      "load_spec": {
        "kind": "spec_path",
        "name": "tailwindcss"
      }
    },
    {
      "names": [
        "next"
      ],
      "icon": "https://nextjs.org/static/favicon/favicon-16x16.png",
      "load_spec": {
        "kind": "spec_path",
        "name": "next"
      }
    },
    {
      "names": [
        "gltfjsx"
      ],
      "icon": "https://raw.githubusercontent.com/pmndrs/branding/master/logo.svg",
      "load_spec": {
        "kind": "spec_path",
        "name": "gltfjsx"
      }
    },
    {
      "names": [
        "prisma"
      ],
      "icon": "https://raw.githubusercontent.com/prisma/docs/main/src/images/favicon-16x16.png",
      "load_spec": {
        "kind": "spec_path",
        "name": "prisma"
      }
    }
  ],
  "options": [
    {
      "names": [
        "--package",
        "-p"
      ],
      "description": "Package to be executed",
      "args": [
        {
          "name": "package"
        }
      ]
    },
    {
      "names": [
        "--cache"
      ],
      "description": "Location of the npm cache",
      "args": [
        {
          "name": "path",
          "templates": [
            "filepaths"
          ]
        }
      ]
    },
    {
      "names": [
        "--always-spawn"
      ],
      "description": "Always spawn a child process to execute the command"
    },
    {
      "names": [
        "--no-install"
      ],
      "description": "Skip installation if a package is missing"
    },
    {
      "names": [
        "--userconfig"
      ],
      "description": "Path to user npmrc",
      "args": [
        {
          "name": "path",
          "templates": [
            "filepaths"
          ]
        }
      ]
    },
    {
      "names": [
        "--call",
        "-c"
      ],
      "description": "Execute string as if inside `npm run-script`",
      "args": [
        {
          "name": "script"
        }
      ]
    },
    {
      "names": [
        "--shell",
        "-s"
      ],
      "description": "Shell to execute the command with, if any",
      "args": [
        {
          "name": "shell",
          "suggestions": [
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "zsh"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--shell-auto-fallback"
      ],
      "description": "Generate shell code to use pnpx as the \"command not found\" fallback",
      "args": [
        {
          "name": "shell-fallback",
          "suggestions": [
            {
              "name": "bash"
            },
            {
              "name": "fish"
            },
            {
              "name": "zsh"
            }
          ]
        }
      ]
    },
    {
      "names": [
        "--ignore-existing"
      ],
      "description": "Ignores existing binaries in $PATH, or in the localproject. This forces pnpx to do a temporary install and use the latest version"
    },
    {
      "names": [
        "--quiet",
        "-q"
      ],
      "description": "Suppress output from pnpx itself. Subcommands will not be affected"
    },
    {
      "names": [
        "--npm"
      ],
      "description": "Npm binary to use for internal operations",
      "args": [
        {
          "name": "path to binary",
          "templates": [
            "filepaths"
          ]
        }
      ]
    },
    {
      "names": [
        "--node-arg",
        "-n"
      ],
      "description": "Extra node argument when calling a node binary",
      "args": [
        {}
      ]
    },
    {
      "names": [
        "--version",
        "-v"
      ],
      "description": "Show version number"
    },
    {
      "names": [
        "--help",
        "-h"
      ],
      "description": "Show help"
    }
  ]
}
