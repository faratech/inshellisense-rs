        {
          "names": [
            "-h",
            "--help"
          ],
          "description": "Display help for command",
          "priority": 49
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Name of the planter to show info for"
        }
      ]
    },
    {
      "names": [
        "help"
      ],
      "description": "Display help for command",
