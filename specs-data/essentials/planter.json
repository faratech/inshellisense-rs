        },
        {
          "name": "dir",
          "description": "Directory of the new project",
          "is_optional": true
        }
      ]
    },
    {
      "names": [
        "list"
      ],
      "description": "List available planters",
      "options": [
        {
          "names": [
            "-a",
            "--alphanumeric"
          ],
          "description": "Sorts list of planters alphanumerically"
        },
        {
          "names": [
            "-h",
            "--help"
          ],
          "description": "Display help for command",
          "priority": 49
        }
      ]
    },
    {
      "names": [
        "add"
      ],
