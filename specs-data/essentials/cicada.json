{
  "names": [
    "cicada"
  ],
  "description": "Write CI/CD Pipelines in TypeScript",
  "subcommands": [
    {
      "names": [
        "run"
      ],
      "description": "Run a cicada pipeline",
      "options": [
        {
          "names": [
            "-s",
            "--secret"
          ],
          "description": "Name of the secret to use, these come from environment variables",
          "is_repeatable": true,
          "args": [
            {
              "name": "secret",
              "is_optional": true
            }
          ]
        },
        {
          "names": [
            "--dotenv"
          ],
          "description": "Load a custom .env file",
          "is_repeatable": true,
          "args": [
            {
              "name": "dotenv",
              "is_optional": true,
              "templates": [
                "filepaths"
              ]
            }
          ]
        },
        {
          "names": [
            "--secrets-json"
          ],
          "description": "Load secrets from a json file",
          "is_repeatable": true,
          "args": [
            {
              "name": "secrets_json",
              "is_optional": true,
              "templates": [
                "filepaths"
              ]
            }
          ]
        },
        {
          "names": [
            "--cicada-dockerfile"
          ],
          "description": "A custom dockerfile to load the cicada bin from",
          "hidden": true,
          "is_repeatable": true,
          "args": [
            {
              "name": "cicada_dockerfile",
              "is_optional": true,
              "templates": [
                "filepaths"
              ]
            }
          ]
        },
        {
          "names": [
            "--oci-backend"
          ],
          "description": "The OCI backend to use",
          "is_repeatable": true,
          "args": [
            {
              "name": "oci_backend",
              "is_optional": true,
              "suggestions": [
                {
                  "name": "docker"
                },
                {
                  "name": "podman"
                }
              ]
            }
          ]
        },
        {
          "names": [
            "--no-dotenv"
          ],
          "description": "Do not load .env file"
        },
        {
          "names": [
            "--no-cache"
          ],
          "description": "Disable caching"
        },
        {
          "names": [
            "-h",
            "--help"
          ],
          "description": "Print help (see more with '--help')"
        }
      ],
      "args": [
        {
          "name": "pipeline",
          "is_optional": true,
          "templates": [
            "filepaths"
          ]
        }
      ]
    },
    {
      "names": [
        "step"
      ],
      "description": "Run a step in a cicada workflow",
